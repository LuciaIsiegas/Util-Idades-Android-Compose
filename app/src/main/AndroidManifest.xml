<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_lia_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_lia_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UtilIdades">
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".shoppinglist.FormActivity"
            android:exported="false"
            android:label="@string/title_activity_form_product"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".shoppinglist.ImagesActivity"
            android:exported="false"
            android:label="@string/title_activity_images"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".ShoppingListActivity"
            android:exported="false"
            android:label="@string/title_activity_shopping_list"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".CalculatorActivity"
            android:exported="false"
            android:label="@string/title_activity_calculator"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".ConversorActivity"
            android:exported="false"
            android:label="@string/title_activity_conversor"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".NewsActivity"
            android:exported="false"
            android:label="@string/title_activity_conversor"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:label="@string/title_activity_qr_scanner"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".Magic8BallActivity"
            android:exported="false"
            android:label="@string/title_activity_pool_8"
            android:theme="@style/Theme.UtilIdades" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.UtilIdades">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>